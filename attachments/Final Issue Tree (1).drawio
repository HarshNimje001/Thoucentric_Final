        <mxCell id="23hkRLPfUXfo8b9_7GuW-23" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;fontColor=#ffffff;strokeColor=#A50040;" value="&lt;h3 data-section-id=&quot;1t5rxhj&quot; data-start=&quot;2710&quot; data-end=&quot;2738&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;ROOT CAUSE:&lt;/font&gt;&lt;/h3&gt;&lt;blockquote data-start=&quot;2740&quot; data-end=&quot;2897&quot; data-is-last-node=&quot;&quot; data-is-only-node=&quot;&quot;&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;&amp;lt;br/&amp;gt;line-height:normal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-family:&amp;quot;Arial&amp;quot;,sans-serif;mso-fareast-font-family:&amp;lt;br/&amp;gt;&amp;quot;Times New Roman&amp;quot;;mso-font-kerning:0pt;mso-ligatures:none;mso-fareast-language:&amp;lt;br/&amp;gt;EN-IN&quot;&gt;A potential gap in the granularity and responsiveness of EIC&#39;s network planning and capacity-allocation process, resulting in fixed charging capacity not being sufficiently aligned with evolving area-level, customer-segment and peak-period demand.&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-family:&amp;quot;Arial&amp;quot;,sans-serif;&amp;lt;br/&amp;gt;mso-fareast-font-family:&amp;quot;Times New Roman&amp;quot;;mso-font-kerning:0pt;mso-ligatures:&amp;lt;br/&amp;gt;none;mso-fareast-language:EN-IN&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="100" width="680" x="20" y="690" as="geometry" />
        </mxCell>
        <mxCell id="23hkRLPfUXfo8b9_7GuW-24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d80073;fontColor=#ffffff;strokeColor=#A50040;" value="&lt;h3 data-section-id=&quot;16zp0ag&quot; data-start=&quot;124&quot; data-end=&quot;148&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;ANALYSIS / DIAGNOSIS:&lt;/font&gt;&lt;/h3&gt;&lt;blockquote data-start=&quot;149&quot; data-end=&quot;339&quot;&gt;&lt;p data-start=&quot;151&quot; data-end=&quot;339&quot;&gt;&lt;strong data-start=&quot;151&quot; data-end=&quot;339&quot;&gt;Demand is uneven across time and locations, while EIC&#39;s 2,800-station network has only 46% average utilization, creating congestion at high-demand stations and idle capacity elsewhere.&lt;/strong&gt;&lt;/p&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="80" width="620" x="50" y="820" as="geometry" />
