        <mxCell id="23hkRLPfUXfo8b9_7GuW-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#ffcd28;gradientColor=#ffa500;strokeColor=#d79b00;" value="&lt;p data-start=&quot;1430&quot; data-end=&quot;1456&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;strong data-start=&quot;1430&quot; data-end=&quot;1456&quot;&gt;3.1 Demand Forecasting&lt;/strong&gt;&lt;/p&gt;&lt;ul data-start=&quot;1457&quot; data-end=&quot;1532&quot;&gt;&lt;li data-section-id=&quot;12g3i6x&quot; data-start=&quot;1457&quot; data-end=&quot;1486&quot;&gt;Need AI-enabled forecasting&lt;/li&gt;&lt;li data-section-id=&quot;12n7hcj&quot; data-start=&quot;1487&quot; data-end=&quot;1532&quot;&gt;Anticipate where and when demand will occur&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1534&quot; data-end=&quot;1556&quot;&gt;&lt;strong data-start=&quot;1534&quot; data-end=&quot;1556&quot;&gt;3.2 Load Balancing&lt;/strong&gt;&lt;/p&gt;&lt;ul data-start=&quot;1557&quot; data-end=&quot;1645&quot;&gt;&lt;li data-section-id=&quot;wsnoek&quot; data-start=&quot;1557&quot; data-end=&quot;1593&quot;&gt;Need mechanisms to redirect demand&lt;/li&gt;&lt;li data-section-id=&quot;1wnedbo&quot; data-start=&quot;1594&quot; data-end=&quot;1645&quot;&gt;Shift demand from congested to available stations&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1647&quot; data-end=&quot;1670&quot;&gt;&lt;strong data-start=&quot;1647&quot; data-end=&quot;1670&quot;&gt;3.3 Dynamic Pricing&lt;/strong&gt;&lt;/p&gt;&lt;ul data-start=&quot;1671&quot; data-end=&quot;1761&quot;&gt;&lt;li data-section-id=&quot;1s872at&quot; data-start=&quot;1671&quot; data-end=&quot;1722&quot;&gt;Use pricing levers to influence charging behavior&lt;/li&gt;&lt;li data-section-id=&quot;1rjwxd3&quot; data-start=&quot;1723&quot; data-end=&quot;1761&quot;&gt;Reduce peak-hour/location congestion&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1763&quot; data-end=&quot;1783&quot;&gt;&lt;strong data-start=&quot;1763&quot; data-end=&quot;1783&quot;&gt;3.4 Reservations&lt;/strong&gt;&lt;/p&gt;&lt;ul data-start=&quot;1784&quot; data-end=&quot;1868&quot;&gt;&lt;li data-section-id=&quot;1wskge7&quot; data-start=&quot;1784&quot; data-end=&quot;1821&quot;&gt;Allow customers to see availability&lt;/li&gt;&lt;li data-section-id=&quot;2136yy&quot; data-start=&quot;1822&quot; data-end=&quot;1868&quot;&gt;Enable advance reservation of charging slots&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1870&quot; data-end=&quot;1900&quot;&gt;&lt;strong data-start=&quot;1870&quot; data-end=&quot;1900&quot;&gt;3.5 Predictive Maintenance&lt;/strong&gt;&lt;/p&gt;&lt;ul data-start=&quot;1901&quot; data-end=&quot;1958&quot;&gt;&lt;li data-section-id=&quot;gh5gpx&quot; data-start=&quot;1901&quot; data-end=&quot;1928&quot;&gt;Reduce equipment downtime&lt;/li&gt;&lt;li data-section-id=&quot;k92je2&quot; data-start=&quot;1929&quot; data-end=&quot;1958&quot;&gt;Improve charger reliability&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1960&quot; data-end=&quot;1997&quot;&gt;&lt;strong data-start=&quot;1960&quot; data-end=&quot;1997&quot;&gt;3.6 Remote Monitoring &amp;amp; Analytics&lt;/strong&gt;&lt;/p&gt;&lt;ul data-start=&quot;1998&quot; data-end=&quot;2069&quot;&gt;&lt;li data-section-id=&quot;ck8fs&quot; data-start=&quot;1998&quot; data-end=&quot;2028&quot;&gt;Real-time network monitoring&lt;/li&gt;&lt;li data-section-id=&quot;a5wv9n&quot; data-start=&quot;2029&quot; data-end=&quot;2069&quot;&gt;Faster detection of operational issues&amp;nbsp;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;" vertex="1">
